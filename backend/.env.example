# ================================
# AdManager Pro - Variables de Entorno
# ================================
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el .env real a Git

# Puerto del servidor (Vercel lo ignora, usa el suyo)
PORT=3000

# Base de datos PostgreSQL (en producción usa Neon: https://neon.tech)
DATABASE_URL="postgresql://usuario:password@host/publicidad_db?sslmode=require"

# JWT Secret (mínimo 32 caracteres, usa un generador aleatorio)
JWT_SECRET=cambia_esto_por_un_secreto_muy_seguro_de_al_menos_32_chars

# URL del frontend (en producción pon la URL de Vercel)
# Puedes poner múltiples URLs separadas por coma
FRONTEND_URL=http://localhost:5173
